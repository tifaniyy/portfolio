# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# tulisan jurnal IKUT di-commit (data/journals.json) supaya ikut ter-deploy.
# Alurnya: tulis lewat /journals/kelola di komputer -> commit & push.
# Jadi server hosting tidak perlu izin menulis file sama sekali.
/data/journals.json.tmp

# kata sandi pengelola tulisan (hash) — JANGAN di-commit
/data/admin-auth.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (keep secrets out; .env.example IS committed as documentation)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
